{
  "name": "ediskandarov-blog",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "preview:cloudflare": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "ci": "npm run format:check && npm run check && npm test && npm run build && npm run deploy:dry-run",
    "check": "astro check",
    "type-check": "astro check",
    "test": "node --test",
    "new-post": "node scripts/new-post.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.0",
    "wrangler": "4.150.0"
  },
  "license": "MIT"
}
