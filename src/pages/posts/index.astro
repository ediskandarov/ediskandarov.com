---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import { getPosts } from "../../lib/posts";
const posts = await getPosts({ includeDrafts: import.meta.env.DEV });
---

<BaseLayout
  title="Writing"
  description="Essays and notes on software engineering, entrepreneurship, and building teams."
>
  <header class="page-heading">
    <h1>Writing</h1>
    <p>Things I've learned, things I'm building, and ideas worth sharing.</p>
  </header>
  <section aria-label="All posts">
    <PostList posts={posts} />
  </section>
  {posts.length === 0 && (
    <p class="empty-state">The first post is on its way.</p>
  )}
</BaseLayout>
