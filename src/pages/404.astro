---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="page-heading not-found">
    <p class="eyebrow">404 / A wrong turn</p>
    <h1>
      Nothing here<span class="accent-text">.</span>
    </h1>
    <p>This page may have moved, or the link may be incomplete.</p>
    <a class="text-link" href="/">
      Back to the homepage <span aria-hidden="true">→</span>
    </a>
  </section>
</BaseLayout>
