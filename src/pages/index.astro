---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import { getPosts } from "../lib/posts";
const posts = await getPosts({ includeDrafts: import.meta.env.DEV });
---

<BaseLayout>
  <section class="hero" aria-labelledby="intro-title">
    <h1 id="intro-title">Personal notes</h1>
    <p class="hero-description">
      I'm a software engineer and entrepreneur. This is where I write about
      software, startups, and the people behind them.
    </p>
    <a class="text-link" href="/about">
      About me
    </a>
  </section>
  <section class="writing-section" aria-labelledby="writing-title">
    <div class="section-heading">
      <h2 id="writing-title">Recent posts</h2>
      <a class="text-link" href="/posts">
        All posts
      </a>
    </div>
    <PostList posts={posts.slice(0, 5)} heading="h3" />
    {posts.length === 0 && (
      <p class="empty-state">The first post is on its way.</p>
    )}
  </section>
</BaseLayout>
